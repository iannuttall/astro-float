{
  "name": "astro-lee",
  "version": "0.0.1",
  "description": "Lee, the Little Entry Editor: edit Astro content collection entries on the page. Dev-only, lives in the Astro Dev Toolbar.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./editor": {
      "types": "./src/editor.ts",
      "default": "./src/editor.ts"
    },
    "./hosted": {
      "types": "./src/hosted.ts",
      "default": "./src/hosted.ts"
    },
    "./document": {
      "types": "./src/document.d.ts",
      "default": "./src/document.js"
    },
    "./schema": {
      "types": "./src/schema.d.ts",
      "default": "./src/server/schema.js"
    }
  },
  "types": "./index.d.ts",
  "bin": {
    "astro-lee": "./src/cli.js"
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "dev-toolbar",
    "cms",
    "content-collections"
  ],
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "astro": "^7.4.2",
    "jsdom": "^25.0.1",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "astro-float",
  "version": "0.0.1",
  "description": "Minimal floating content editor for Astro content collections. Dev-only, lives in the Astro Dev Toolbar.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
